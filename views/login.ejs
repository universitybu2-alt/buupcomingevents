<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="icon" type="image/png" href="/assets/icon2.png">
    <title>Login Page</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/loginsignup.css">
</head>
<body>
    <!-- Description at top -->
    <div class="dis text-center">
        <p>
            Get ready for an exciting upcoming event at Bundelkhand University,
            bringing together students, faculty, and guests for a memorable
            experience filled with learning, creativity, and interaction.
        </p>
    </div>

    <!-- Login box -->
    <div class="main">
        <!-- Logo inside login box -->
        <div class="logo-box">
            <img
                src="/assets/logo.jpeg"
                alt="Bundelkhand University Logo"
                class="event-logo"
            >
        </div>
        <div class="head">
            <h2>Login</h2>
        </div>

        <form action="/login" method="POST">
            <div class="form">

                <label for="email">Email:</label>
                <input
                    type="email"
                    id="email"
                    name="username"
                    placeholder="Enter your email"
                    class="form-control"
                    required
                    autocomplete="off"
                >

                <label for="password">Password:</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Password"
                    class="form-control"
                    required
                >

            </div>

            <button type="submit" class="btn btn-primary w-100">
                Sign In
            </button>

        </form>

        <!-- Signup at bottom of login box -->
        <p class="signup-text">
            Don't have an account?
            <a href="/signup">Sign Up</a>
        </p>

    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>

</body>
</html>